# --- AREP backend configuration -------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
ENV=local
DEBUG=true

# Local / Termux (no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./arep_dev.db
# Server (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://arep:CHANGE_ME@localhost:5432/arep

# REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret
JWT_TTL_MINUTES=720

# From @BotFather. Required for real Telegram login.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE=86400

# Must be false in production.
ALLOW_DEV_LOGIN=true

CORS_ORIGINS=*

# AI Provider: mock (default, no key, rule-based Persian), openai, gemini, claude, local
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# CLAUDE_API_KEY=...
# ANTHROPIC_API_KEY=...

# Integrations Phase 15 — all mock by default, no external API required
TELEGRAM_PROVIDER=mock
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=arep_bot

SMS_PROVIDER=mock
# SMS_API_KEY=...
# KAVENEGAR_API_KEY=...

DIVAR_PROVIDER=mock
# DIVAR_API_KEY=...

SHEYPOOR_PROVIDER=mock
# SHEYPOOR_API_KEY=...

PAYMENT_PROVIDER=mock
# PAYMENT_API_KEY=...
# ZARINPAL_API_KEY=...

MAPS_PROVIDER=mock
# MAPS_PROVIDER=osm for OpenStreetMap Nominatim (free, no key)
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
